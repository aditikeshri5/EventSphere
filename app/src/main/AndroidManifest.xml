            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".InterestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EventDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EventRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
