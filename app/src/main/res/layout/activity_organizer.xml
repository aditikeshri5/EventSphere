<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC">

    <!-- Permanent Organizer App Bar -->
    <LinearLayout
        android:id="@+id/organizerAppBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/organizer_logo_bg"
            android:gravity="center"
            android:text="E"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EventSphere"
                android:textColor="#5033D8"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organizer Portal"
                android:textColor="#777386"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnOrganizerNotifications"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Notifications"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#5033D8" />

    </LinearLayout>

    <!-- Organizer screens appear here -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/organizerFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/organizerAppBar"
        app:layout_constraintBottom_toTopOf="@id/organizerBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Permanent Bottom Navigation -->
    <LinearLayout
        android:id="@+id/organizerBottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navOrganizerDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOrganizerDashboard"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Dashboard"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#5033D8" />

            <TextView
                android:id="@+id/textOrganizerDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dashboard"
                android:textColor="#5033D8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOrganizerEvents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOrganizerEvents"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Events"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#777386" />

            <TextView
                android:id="@+id/textOrganizerEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Events"
                android:textColor="#777386"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOrganizerRegistrations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOrganizerRegistrations"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Registrations"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="#777386" />

            <TextView
                android:id="@+id/textOrganizerRegistrations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registrations"
                android:textColor="#777386"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOrganizerProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOrganizerProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Profile"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#777386" />

            <TextView
                android:id="@+id/textOrganizerProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profile"
                android:textColor="#777386"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
