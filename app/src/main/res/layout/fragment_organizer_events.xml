<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:padding="16dp">

    <!-- Heading -->
    <TextView
        android:id="@+id/tvOrganizerEventsHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Manage My Events"
        android:textColor="#302B40"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvOrganizerEventsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="View and manage events you have published."
        android:textColor="#777386"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvOrganizerEventsHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Event count -->
    <TextView
        android:id="@+id/tvOrganizerEventsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Your Events (0)"
        android:textColor="#302B40"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvOrganizerEventsSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add event button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddOrganizerEvent"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="+ Create New Event"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="#5033D8"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvOrganizerEventsCount"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutNoOrganizerEvents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnAddOrganizerEvent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▦"
            android:textColor="#5033D8"
            android:textSize="42sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No events yet"
            android:textColor="#302B40"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Create your first event and it will appear here."
            android:textColor="#777386"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Events fetched from Firestore -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrganizerEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddOrganizerEvent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
