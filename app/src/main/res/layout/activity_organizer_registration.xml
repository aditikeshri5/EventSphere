<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".OrganizerRegistrationActivity">

    <ScrollView
        android:id="@+id/registrationScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Back Button -->
            <TextView
                android:id="@+id/btnOrganizerBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="#7C3AED"
                android:textSize="16sp"
                android:paddingBottom="20dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- App Icon -->
            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:gravity="center"
                android:background="@drawable/organizer_logo_bg"
                android:text="E"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Become an Organizer"
                android:textColor="#202124"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:text="Create your account and start hosting events"
                android:textColor="#777777"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Organizer Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Organizer / Organization Name"
                android:textColor="#303030"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etOrganizerName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="Enter your name or organization"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#202124"
                android:textColorHint="#999999"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Email Address"
                android:textColor="#303030"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOrganizerEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="Enter your email"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#202124"
                android:textColorHint="#999999"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true" />

            <!-- Password Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Password"
                android:textColor="#303030"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Password Field with Eye Icon -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/organizerRegisterPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#D9D2E8"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#777386"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrganizerPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Create a password"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#202124"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Confirm Password"
                android:textColor="#303030"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Confirm Password Field with Eye Icon -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/organizerConfirmPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#D9D2E8"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#777386"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrganizerConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Re-enter your password"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#202124"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Create Account Button -->
            <Button
                android:id="@+id/btnOrganizerRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#7C3AED"
                android:text="Create Organizer Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Login Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="22dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOrganizerLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log in"
                    android:textColor="#7C3AED"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
