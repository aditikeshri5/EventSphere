<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnCreateEventBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:text="← Back"
            android:textColor="#5033D8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create New Event"
            android:textColor="#25213A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Share your event with the EventSphere community."
            android:textColor="#777386"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event title *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="Enter event name"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Category *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCreateEventCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:paddingHorizontal="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Event date *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select event date"
                android:paddingHorizontal="12dp"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Event time *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select event time"
                android:paddingHorizontal="12dp"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Venue *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventVenue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="College auditorium, hotel, etc."
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="City *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventCity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="Enter city"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Organizer name *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateOrganizerName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:hint="Club or organizer name"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Description *"
                android:textColor="#25213A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreateEventDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/organizer_input_bg"
                android:gravity="top|start"
                android:hint="Describe the event, activities and important details"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textColor="#25213A"
                android:textColorHint="#9994A8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registration required"
                        android:textColor="#25213A"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Allow users to register through the app"
                        android:textColor="#777386"
                        android:textSize="12sp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchRegistrationRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="Registration required" />

            </LinearLayout>

            <Button
                android:id="@+id/btnPublishEvent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#5033D8"
                android:text="Publish Event"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="* Required fields"
            android:textColor="#777386"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
