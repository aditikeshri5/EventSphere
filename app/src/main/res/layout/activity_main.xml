<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- EventSphere Logo -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="45dp"
            android:gravity="center"
            android:background="@drawable/organizer_logo_bg"
            android:text="E"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="EventSphere"
            android:textColor="#5033D8"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Welcome Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Discover. Connect. Experience."
            android:textColor="#25213A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose how you want to continue"
            android:textColor="#777386"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- User Option -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For Event Attendees"
                android:textColor="#25213A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explore events, discover your interests and register for experiences."
                android:textColor="#777386"
                android:textSize="14sp" />

            <!-- Continue as User Button -->
            <Button
                android:id="@+id/btnContinueAsUser"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#5033D8"
                android:text="Continue as User"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Organizer Option -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For Event Organizers"
                android:textColor="#25213A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Create events, manage registrations and connect with attendees."
                android:textColor="#777386"
                android:textSize="14sp" />

            <!-- Continue as Organizer Button -->
            <Button
                android:id="@+id/btnContinueAsOrganizer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#5033D8"
                android:text="Continue as Organizer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="Your next experience starts here."
            android:textColor="#777386"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>